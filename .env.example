# Dotwall — Environment Configuration
# Copy this file to .env.local and fill in your Supabase project credentials
# to switch from the built-in Real-Time Local Multiplayer Server to Supabase Cloud.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
